# Read by Cloudflare Pages and Netlify. Ignored by a plain static server, so it
# is harmless in local dev.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()

# Fingerprinted by the ?v= query in the HTML, so a cached copy is only ever
# reused for a URL that has not changed. Safe to pin for a year.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts never change in place — a new face means a new filename.
#
# Images are the exception and the trap: some have been re-generated under
# their existing name (swapnil-hero.*, band-studio.webp). Because this rule
# pins them for a year, a returning visitor would otherwise keep the old
# picture indefinitely. IF YOU REPLACE AN IMAGE WITHOUT RENAMING IT, bump the
# ?v= on its URL in index.html — that is what makes the new bytes reachable.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The document itself must always revalidate, or the ?v= bumps inside it would
# never reach anyone.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
